<included>

    <!-- One place for the pattern, so the console and the file read the same. -->
    <property name="GYM_LOG_PATTERN"
              value="%d{HH:mm:ss.SSS} %-5level [%X{transactionId}] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${GYM_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

</included>
