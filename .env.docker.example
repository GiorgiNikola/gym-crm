# Copy to .env.docker and fill in a password. .env.docker is git ignored.
POSTGRES_DB=gymcrm
POSTGRES_USER=gymcrm
POSTGRES_PASSWORD=replace-me

# The host is the db service name on the compose network, not localhost.
DB_URL=jdbc:postgresql://gymcrm-db:5432/gymcrm
DB_USERNAME=gymcrm
DB_PASSWORD=replace-me
