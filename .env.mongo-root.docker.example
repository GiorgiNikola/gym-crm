# Copy to .env.mongo-root.docker and put a generated password in it. .env.mongo-root.docker is git ignored.
# Read only by the mongo container. For example: openssl rand -hex 24
# The entrypoint uses it only when the gymcrm-mongo-data volume is empty: a change needs a new volume.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=replace-me
