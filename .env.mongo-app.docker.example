# Copy to .env.mongo-app.docker and put a generated password in it. .env.mongo-app.docker is git ignored.
# Read by the mongo init script and by workload-service. A hex password, for example: openssl rand -hex 24
# (it goes into MONGO_URI unencoded). The init script runs only on an empty gymcrm-mongo-data volume.
MONGO_APP_DATABASE=workload
MONGO_APP_USERNAME=workload
MONGO_APP_PASSWORD=replace-me
